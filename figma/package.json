{
  "name": "chart-color-figma",
  "private": true,
  "type": "module",
  "description": "The Chart Color System as a Figma plugin. Proprietary; bundles the MIT engine in-repo via the @engine alias.",
  "scripts": {
    "build": "npm run build:sandbox && npm run build:ui",
    "build:sandbox": "vite build --config vite.config.sandbox.ts",
    "build:ui": "vite build --config vite.config.ui.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^4.1.10"
  }
}
